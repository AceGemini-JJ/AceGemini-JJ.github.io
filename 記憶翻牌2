<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🃏 記憶翻牌｜超印J-J</title>

<style>
*{
    box-sizing:border-box;
    -webkit-tap-highlight-color:transparent;
}

body{
    margin:0;
    min-height:100vh;
    font-family:"Arial","Microsoft JhengHei",sans-serif;
    background:
        linear-gradient(180deg,#7ddcff 0%,#dff8ff 55%,#9ee493 55%,#65c466 100%);
    color:#263238;
}

header{
    text-align:center;
    padding:18px 12px 12px;
}

header h1{
    margin:0;
    font-size:clamp(28px,6vw,46px);
    color:#fff;
    text-shadow:0 4px 0 rgba(0,0,0,.12);
}

header p{
    margin:6px 0;
    color:#fff;
    font-size:15px;
}

.top-buttons{
    display:flex;
    justify-content:center;
    gap:10px;
    margin:12px auto;
    flex-wrap:wrap;
}

button{
    border:0;
    cursor:pointer;
    font-family:inherit;
    font-weight:bold;
}

.home-btn,
.music-btn,
.restart-btn{
    padding:10px 18px;
    border-radius:30px;
    background:#fff;
    color:#3949ab;
    box-shadow:0 4px 10px rgba(0,0,0,.15);
    font-size:15px;
}

.home-btn:hover,
.music-btn:hover,
.restart-btn:hover{
    transform:translateY(-2px);
}

.level-box{
    width:min(1000px,94%);
    margin:8px auto 14px;
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:10px;
}

.level-btn{
    padding:13px 8px;
    border-radius:18px;
    background:rgba(255,255,255,.9);
    box-shadow:0 4px 10px rgba(0,0,0,.12);
    transition:.2s;
}

.level-btn strong{
    display:block;
    font-size:17px;
}

.level-btn span{
    display:block;
    margin-top:3px;
    font-size:12px;
    color:#666;
}

.level-btn.active{
    background:#3949ab;
    color:white;
    transform:scale(1.04);
}

.level-btn.active span{
    color:#e8eaf6;
}

.stats{
    width:min(1000px,94%);
    margin:0 auto 14px;
    display:grid;
    grid-template-columns:repeat(5,1fr);
    gap:8px;
}

.stat{
    background:rgba(255,255,255,.92);
    border-radius:15px;
    padding:10px 5px;
    text-align:center;
    box-shadow:0 3px 8px rgba(0,0,0,.12);
}

.stat-title{
    font-size:12px;
    color:#777;
}

.stat-value{
    margin-top:3px;
    font-size:21px;
    font-weight:bold;
    color:#303f9f;
}

.timer-danger{
    color:#e53935 !important;
    animation:pulse .7s infinite alternate;
}

@keyframes pulse{
    from{transform:scale(1);}
    to{transform:scale(1.12);}
}

.game-area{
    width:min(1100px,96%);
    margin:auto;
}

.board{
    display:grid;
    gap:9px;
    justify-content:center;
    perspective:1000px;
}

.card{
    aspect-ratio:1/1;
    min-width:0;
    cursor:pointer;
    perspective:900px;
}

.card-inner{
    width:100%;
    height:100%;
    position:relative;
    transition:transform .45s cubic-bezier(.2,.7,.2,1);
    transform-style:preserve-3d;
}

.card.flipped .card-inner,
.card.matched .card-inner{
    transform:rotateY(180deg);
}

.card-face{
    position:absolute;
    inset:0;
    backface-visibility:hidden;
    border-radius:14px;
    display:flex;
    justify-content:center;
    align-items:center;
    user-select:none;
}

.card-front{
    background:
        linear-gradient(135deg,#5c6bc0,#3949ab);
    color:#fff;
    font-size:clamp(20px,4vw,32px);
    box-shadow:
        inset 0 0 0 3px rgba(255,255,255,.2),
        0 4px 8px rgba(0,0,0,.18);
}

.card-front::after{
    content:"❓";
    opacity:.9;
}

.card-back{
    transform:rotateY(180deg);
    background:#fff;
    font-size:clamp(25px,5vw,48px);
    box-shadow:
        inset 0 0 0 3px #e8eaf6,
        0 4px 8px rgba(0,0,0,.15);
}

.card.matched .card-back{
    animation:matchPop .45s ease;
    box-shadow:
        inset 0 0 0 4px #66bb6a,
        0 0 15px rgba(76,175,80,.5);
}

.card.wrong{
    animation:shake .4s ease;
}

@keyframes matchPop{
    0%{transform:rotateY(180deg) scale(1);}
    50%{transform:rotateY(180deg) scale(1.15);}
    100%{transform:rotateY(180deg) scale(1);}
}

@keyframes shake{
    0%,100%{transform:translateX(0);}
    25%{transform:translateX(-7px);}
    50%{transform:translateX(7px);}
    75%{transform:translateX(-5px);}
}

.bottom-area{
    text-align:center;
    margin:18px auto 10px;
}

.restart-btn{
    background:#ffca28;
    color:#5d4037;
}

.tip{
    margin:10px auto;
    color:#fff;
    font-weight:bold;
    text-shadow:0 2px 3px rgba(0,0,0,.18);
}

footer{
    text-align:center;
    color:#fff;
    font-weight:bold;
    padding:18px 10px 25px;
    text-shadow:0 2px 3px rgba(0,0,0,.2);
}

/* Modal */

.modal{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.55);
    display:none;
    justify-content:center;
    align-items:center;
    padding:20px;
    z-index:100;
}

.modal.show{
    display:flex;
}

.modal-box{
    width:min(430px,95%);
    background:#fff;
    border-radius:28px;
    padding:28px 20px;
    text-align:center;
    box-shadow:0 15px 40px rgba(0,0,0,.3);
    animation:modalIn .35s ease;
}

@keyframes modalIn{
    from{
        transform:scale(.7);
        opacity:0;
    }
    to{
        transform:scale(1);
        opacity:1;
    }
}

.modal-box h2{
    margin:0 0 10px;
    color:#3949ab;
    font-size:30px;
}

.result-stars{
    font-size:38px;
    margin:10px;
}

.result-text{
    line-height:1.8;
    font-size:16px;
}

.modal-buttons{
    margin-top:18px;
    display:flex;
    justify-content:center;
    gap:10px;
    flex-wrap:wrap;
}

.modal-buttons button{
    padding:12px 20px;
    border-radius:25px;
}

.play-again{
    background:#3949ab;
    color:white;
}

.go-home{
    background:#eee;
    color:#444;
}

/* 粒子 */

.particle{
    position:fixed;
    pointer-events:none;
    font-size:25px;
    z-index:200;
    animation:particleFly 1s ease-out forwards;
}

@keyframes particleFly{
    0%{
        transform:translate(0,0) scale(.6);
        opacity:1;
    }
    100%{
        transform:translate(var(--x),var(--y)) scale(1.2);
        opacity:0;
    }
}

/* 桌機尺寸 */

.board.easy{
    grid-template-columns:repeat(4,minmax(55px,110px));
}

.board.normal{
    grid-template-columns:repeat(6,minmax(48px,105px));
}

.board.hard{
    grid-template-columns:repeat(6,minmax(44px,95px));
}

.board.pro{
    grid-template-columns:repeat(8,minmax(38px,82px));
}

/* 手機 */

@media(max-width:650px){

    .level-box{
        grid-template-columns:repeat(2,1fr);
    }

    .stats{
        grid-template-columns:repeat(3,1fr);
    }

    .stat:nth-child(4),
    .stat:nth-child(5){
        grid-column:auto;
    }

    .board{
        gap:5px;
    }

    .board.easy{
        grid-template-columns:repeat(4,1fr);
    }

    .board.normal{
        grid-template-columns:repeat(4,1fr);
    }

    .board.hard{
        grid-template-columns:repeat(6,1fr);
    }

    .board.pro{
        grid-template-columns:repeat(6,1fr);
    }

    .card-face{
        border-radius:9px;
    }

    .card-back{
        font-size:clamp(19px,7vw,32px);
    }

    .card-front{
        font-size:18px;
    }
}
</style>
</head>

<body>

<header>

<h1>🃏 記憶翻牌</h1>
<p>記住位置，把相同的圖案找出來！</p>

<div class="top-buttons">
    <button class="home-btn" onclick="location.href='index.html'">
        🏠 首頁
    </button>

    <button class="music-btn" id="musicBtn" onclick="toggleMusic()">
        🔇 音樂：關
    </button>
</div>

<div class="level-box">

    <button class="level-btn active" data-level="easy" onclick="changeLevel('easy')">
        <strong>🟢 初級 ×1</strong>
        <span>6 對・12 張</span>
    </button>

    <button class="level-btn" data-level="normal" onclick="changeLevel('normal')">
        <strong>🔵 中級 ×2</strong>
        <span>12 對・24 張</span>
    </button>

    <button class="level-btn" data-level="hard" onclick="changeLevel('hard')">
        <strong>🟠 高級 ×4</strong>
        <span>18 對・36 張</span>
    </button>

    <button class="level-btn" data-level="pro" onclick="changeLevel('pro')">
        <strong>🔴 專業 ×8</strong>
        <span>24 對・48 張</span>
    </button>

</div>

</header>


<div class="stats">

    <div class="stat">
        <div class="stat-title">⭐ 分數</div>
        <div class="stat-value" id="score">0</div>
    </div>

    <div class="stat">
        <div class="stat-title">🎯 步數</div>
        <div class="stat-value" id="moves">0</div>
    </div>

    <div class="stat">
        <div class="stat-title">🔥 連擊</div>
        <div class="stat-value" id="combo">0</div>
    </div>

    <div class="stat">
        <div class="stat-title">⏱️ 時間</div>
        <div class="stat-value" id="timer">∞</div>
    </div>

    <div class="stat">
        <div class="stat-title">🏆 最高分</div>
        <div class="stat-value" id="best">0</div>
    </div>

</div>


<main class="game-area">

    <div id="board" class="board easy"></div>

    <div class="bottom-area">

        <div class="tip" id="tip">
            點擊卡牌開始遊戲！
        </div>

        <button class="restart-btn" onclick="startGame()">
            🔄 重新開始
        </button>

    </div>

</main>


<footer>
    作者－超印J-J　｜　版本 1.0
</footer>


<!-- 完成視窗 -->

<div class="modal" id="modal">

    <div class="modal-box">

        <h2 id="modalTitle">🎉 恭喜完成！</h2>

        <div class="result-stars" id="resultStars">
            ⭐⭐⭐
        </div>

        <div class="result-text" id="resultText"></div>

        <div class="modal-buttons">

            <button class="play-again" onclick="closeModal();startGame();">
                🔄 再玩一次
            </button>

            <button class="go-home" onclick="location.href='index.html'">
                🏠 回首頁
            </button>

        </div>

    </div>

</div>


<script>

/* =========================
   遊戲設定
========================= */

const levels = {

    easy:{
        name:"初級",
        pairs:6,
        multiplier:1,
        time:0,
        penalty:10,
        reward:100
    },

    normal:{
        name:"中級",
        pairs:12,
        multiplier:2,
        time:180,
        penalty:20,
        reward:200
    },

    hard:{
        name:"高級",
        pairs:18,
        multiplier:4,
        time:150,
        penalty:40,
        reward:400
    },

    pro:{
        name:"專業",
        pairs:24,
        multiplier:8,
        time:120,
        penalty:80,
        reward:800
    }

};


/* =========================
   圖案
========================= */

const allEmojis = [

    "🐶","🐱","🐰","🦊",
    "🐼","🐸","🐵","🐯",
    "🦁","🐨","🐷","🐮",
    "🐹","🐻","🐙","🦄",
    "🐝","🦋","🐳","🐬",
    "🦖","🦕","🍎","🍉"

];


/* =========================
   遊戲變數
========================= */

let currentLevel = "easy";

let cards = [];

let firstCard = null;
let secondCard = null;

let lockBoard = false;

let matchedPairs = 0;
let moves = 0;
let score = 0;
let combo = 0;

let timeLeft = 0;
let timerInterval = null;

let gameStarted = false;
let gameOver = false;

let gameToken = 0;


/* =========================
   音效
========================= */

let audioCtx = null;
let musicEnabled = false;
let musicTimer = null;
let musicStep = 0;


function initAudio(){

    if(!audioCtx){

        audioCtx = new (
            window.AudioContext ||
            window.webkitAudioContext
        )();

    }

    if(audioCtx.state === "suspended"){
        audioCtx.resume();
    }

}


function playTone(freq,duration,type="sine",volume=.08){

    if(!audioCtx) return;

    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();

    osc.type = type;
    osc.frequency.value = freq;

    gain.gain.setValueAtTime(volume,audioCtx.currentTime);

    gain.gain.exponentialRampToValueAtTime(
        .001,
        audioCtx.currentTime + duration
    );

    osc.connect(gain);
    gain.connect(audioCtx.destination);

    osc.start();
    osc.stop(audioCtx.currentTime + duration);
}


function flipSound(){
    playTone(500,.08,"sine",.07);
}


function matchSound(){

    playTone(700,.1,"sine",.08);

    setTimeout(()=>{
        playTone(900,.14,"sine",.08);
    },80);

}


function wrongSound(){

    playTone(180,.18,"sawtooth",.05);

}


function finishSound(){

    [523,659,784,1046].forEach((freq,i)=>{

        setTimeout(()=>{
            playTone(freq,.25,"sine",.09);
        },i*120);

    });

}


/* =========================
   背景音樂
========================= */

function toggleMusic(){

    initAudio();

    musicEnabled = !musicEnabled;

    const btn = document.getElementById("musicBtn");

    if(musicEnabled){

        btn.textContent = "🔊 音樂：開";

        startMusic();

    }else{

        btn.textContent = "🔇 音樂：關";

        stopMusic();

    }

}


function startMusic(){

    stopMusic();

    const melody = [
        261.63,
        329.63,
        392,
        329.63,
        293.66,
        349.23,
        440,
        349.23
    ];

    musicStep = 0;

    musicTimer = setInterval(()=>{

        if(!musicEnabled) return;

        playTone(
            melody[musicStep % melody.length],
            .18,
            "triangle",
            .025
        );

        musicStep++;

    },420);

}


function stopMusic(){

    if(musicTimer){

        clearInterval(musicTimer);
        musicTimer = null;

    }

}


/* =========================
   隨機排列
========================= */

function shuffle(array){

    for(let i=array.length-1;i>0;i--){

        const j=Math.floor(Math.random()*(i+1));

        [array[i],array[j]] =
        [array[j],array[i]];

    }

    return array;

}


/* =========================
   切換難度
========================= */

function changeLevel(level){

    currentLevel = level;

    document.querySelectorAll(".level-btn")
    .forEach(btn=>{
        btn.classList.toggle(
            "active",
            btn.dataset.level === level
        );
    });

    startGame();

}


/* =========================
   開始遊戲
========================= */

function startGame(){

    initAudio();

    clearInterval(timerInterval);

    gameToken++;

    firstCard = null;
    secondCard = null;

    lockBoard = false;

    matchedPairs = 0;
    moves = 0;
    score = 0;
    combo = 0;

    gameStarted = false;
    gameOver = false;

    const level = levels[currentLevel];

    timeLeft = level.time;

    updateStats();

    document.getElementById("tip").textContent =
        "記住圖案的位置，找到所有配對！";

    document.getElementById("timer").classList.remove("timer-danger");

    const board = document.getElementById("board");

    board.className =
        "board " + currentLevel;

    board.innerHTML = "";

    let selected = allEmojis.slice(
        0,
        level.pairs
    );

    cards = shuffle([
        ...selected,
        ...selected
    ]);

    cards.forEach((emoji,index)=>{

        const card = document.createElement("div");

        card.className = "card";

        card.dataset.index = index;

        card.innerHTML = `
            <div class="card-inner">

                <div class="card-face card-front"></div>

                <div class="card-face card-back">
                    ${emoji}
                </div>

            </div>
        `;

        card.addEventListener(
            "click",
            ()=>flipCard(card,emoji)
        );

        board.appendChild(card);

    });

}


/* =========================
   翻牌
========================= */

function flipCard(card,emoji){

    if(
        lockBoard ||
        gameOver ||
        card.classList.contains("flipped") ||
        card.classList.contains("matched")
    ){
        return;
    }

    initAudio();

    if(!gameStarted){

        gameStarted = true;

        startTimer();

        document.getElementById("tip").textContent =
            "加油！開始配對！";

    }

    card.classList.add("flipped");

    flipSound();

    if(!firstCard){

        firstCard = {
            element:card,
            emoji:emoji
        };

        return;

    }

    secondCard = {
        element:card,
        emoji:emoji
    };

    moves++;

    checkMatch();

}


/* =========================
   判斷配對
========================= */

function checkMatch(){

    lockBoard = true;

    const token = gameToken;

    if(firstCard.emoji === secondCard.emoji){

        matchedPairs++;

        combo++;

        const level = levels[currentLevel];

        let points =
            level.reward *
            level.multiplier;

        points += combo * 20 * level.multiplier;

        score += points;

        firstCard.element.classList.add("matched");
        secondCard.element.classList.add("matched");

        matchSound();

        createParticles(
            secondCard.element
        );

        updateStats();

        setTimeout(()=>{

            if(token !== gameToken) return;

            firstCard = null;
            secondCard = null;

            lockBoard = false;

            if(
                matchedPairs ===
                levels[currentLevel].pairs
            ){

                finishGame();

            }

        },450);

    }else{

        combo = 0;

        const level = levels[currentLevel];

        score = Math.max(
            0,
            score - level.penalty
        );

        firstCard.element.classList.add("wrong");
        secondCard.element.classList.add("wrong");

        wrongSound();

        updateStats();

        setTimeout(()=>{

            if(token !== gameToken) return;

            firstCard.element.classList.remove(
                "flipped",
                "wrong"
            );

            secondCard.element.classList.remove(
                "flipped",
                "wrong"
            );

            firstCard = null;
            secondCard = null;

            lockBoard = false;

        },700);

    }

}


/* =========================
   計時器
========================= */

function startTimer(){

    clearInterval(timerInterval);

    const level = levels[currentLevel];

    if(level.time === 0){

        document.getElementById("timer").textContent =
            "∞";

        return;

    }

    timerInterval = setInterval(()=>{

        if(gameOver) return;

        timeLeft--;

        updateStats();

        if(timeLeft <= 10){

            document
                .getElementById("timer")
                .classList.add("timer-danger");

        }

        if(timeLeft <= 0){

            clearInterval(timerInterval);

            timeOut();

        }

    },1000);

}


/* =========================
   時間到
========================= */

function timeOut(){

    if(gameOver) return;

    gameOver = true;

    lockBoard = true;

    wrongSound();

    document.getElementById("modalTitle").textContent =
        "⏰ 時間到！";

    document.getElementById("resultStars").textContent =
        "😵";

    document.getElementById("resultText").innerHTML = `
        <b>${levels[currentLevel].name}</b><br>
        已完成：${matchedPairs} / ${levels[currentLevel].pairs} 對<br>
        步數：${moves}<br>
        最終分數：${score}
    `;

    document.getElementById("modal").classList.add("show");

}


/* =========================
   完成遊戲
========================= */

function finishGame(){

    if(gameOver) return;

    gameOver = true;

    clearInterval(timerInterval);

    lockBoard = true;

    finishSound();

    let timeBonus = 0;

    const level = levels[currentLevel];

    if(level.time > 0){

        timeBonus =
            timeLeft *
            10 *
            level.multiplier;

        score += timeBonus;

    }

    const accuracy =
        moves > 0
        ? Math.round(
            (level.pairs / moves) * 100
        )
        : 0;

    if(accuracy >= 90){

        score +=
            500 *
            level.multiplier;

    }else if(accuracy >= 75){

        score +=
            250 *
            level.multiplier;

    }

    updateStats();

    saveBestScore();

    let stars = "⭐";

    if(accuracy >= 90){
        stars = "⭐⭐⭐";
    }else if(accuracy >= 70){
        stars = "⭐⭐";
    }

    document.getElementById("modalTitle").textContent =
        "🎉 全部配對成功！";

    document.getElementById("resultStars").textContent =
        stars;

    document.getElementById("resultText").innerHTML = `

        <b>${level.name} ×${level.multiplier}</b><br>

        🎯 步數：${moves}<br>

        🔥 最佳連擊：${combo}<br>

        🎯 準確率：${accuracy}%<br>

        ⏱️ 剩餘時間：
        ${level.time === 0 ? "∞" : timeLeft + " 秒"}<br>

        ⭐ 最終分數：
        <strong>${score}</strong>

    `;

    document.getElementById("modal").classList.add("show");

}


/* =========================
   分數
========================= */

function updateStats(){

    document.getElementById("score").textContent =
        score;

    document.getElementById("moves").textContent =
        moves;

    document.getElementById("combo").textContent =
        combo;

    document.getElementById("timer").textContent =
        levels[currentLevel].time === 0
        ? "∞"
        : Math.max(0,timeLeft);

    document.getElementById("best").textContent =
        getBestScore();

}


/* =========================
   最高分
========================= */

function getBestScore(){

    return Number(
        localStorage.getItem(
            "memory_best_" + currentLevel
        ) || 0
    );

}


function saveBestScore(){

    const best = getBestScore();

    if(score > best){

        localStorage.setItem(
            "memory_best_" + currentLevel,
            score
        );

    }

}


/* =========================
   粒子特效
========================= */

function createParticles(element){

    const rect =
        element.getBoundingClientRect();

    const symbols = [
        "⭐","✨","🎉","💖","🌟"
    ];

    for(let i=0;i<8;i++){

        const p =
            document.createElement("div");

        p.className = "particle";

        p.textContent =
            symbols[
                Math.floor(
                    Math.random()*symbols.length
                )
            ];

        p.style.left =
            rect.left +
            rect.width/2 +
            "px";

        p.style.top =
            rect.top +
            rect.height/2 +
            "px";

        p.style.setProperty(
            "--x",
            ((Math.random()-.5)*180) + "px"
        );

        p.style.setProperty(
            "--y",
            ((Math.random()-.5)*180) + "px"
        );

        document.body.appendChild(p);

        setTimeout(()=>{
            p.remove();
        },1000);

    }

}


/* =========================
   關閉視窗
========================= */

function closeModal(){

    document
        .getElementById("modal")
        .classList.remove("show");

}


/* =========================
   初始化
========================= */

startGame();

